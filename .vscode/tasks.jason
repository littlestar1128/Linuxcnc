{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Environment",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/dev_env.ps1"
            ],
            "group": "build"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command", "cmake_build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "Setup Environment"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command", "cmake_clean"
            ],
            "group": "build"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command", "cmake_run"
            ],
            "group": "test"
        }
    ]
}