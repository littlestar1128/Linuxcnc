{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug G96",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/g96_test.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PYTHONIOENCODING",
                    "value": "utf-8"
                }
            ],
            "externalConsole": true,  // 使用外部控制台可能解决编码问题
            "console": "externalTerminal",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/liuxin/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        }
    ]
}